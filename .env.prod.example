# ── Django ─────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-a-50+-char-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
DB_ENGINE=postgresql
DB_NAME=almerak_portal
DB_USER=almerak_user
DB_PASSWORD=replace-with-strong-db-password
DB_HOST=db
DB_PORT=5432

# ── CORS / Frontend ────────────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── JWT ────────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Al Merak <no-reply@yourdomain.com>

# ── Review / Invite tokens ─────────────────────────────────────────────────────
REVIEW_TOKEN_EXPIRY_DAYS=14
INVITE_TOKEN_EXPIRY_DAYS=14

# ── Sentry (optional but recommended in production) ────────────────────────────
SENTRY_DSN=

# ── Next.js (used in docker-compose.prod.yml build args) ──────────────────────
NEXT_PUBLIC_API_URL=https://yourdomain.com
